<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0e14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#e8e8ec"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/config_subtitle"
            android:textColor="#8b95a5"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:paddingBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_server_url"
            android:textColor="#8b95a5"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:paddingBottom="6dp" />

        <EditText
            android:id="@+id/input_server_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://garage.alimz.com"
            android:textColor="#e8e8ec"
            android:textColorHint="#3d4f63"
            android:inputType="textUri"
            android:background="@drawable/input_bg"
            android:padding="14dp"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_token"
            android:textColor="#8b95a5"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:paddingTop="20dp"
            android:paddingBottom="6dp" />

        <EditText
            android:id="@+id/input_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_token"
            android:textColor="#e8e8ec"
            android:textColorHint="#3d4f63"
            android:inputType="text"
            android:background="@drawable/input_bg"
            android:padding="14dp"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/token_hint"
            android:textColor="#4b5568"
            android:textSize="12sp"
            android:paddingTop="8dp"
            android:paddingBottom="28dp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_add"
            android:textColor="#0a0e14"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/button_bg" />

        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:textColor="#8b95a5"
            android:textSize="13sp"
            android:gravity="center"
            android:text="" />

    </LinearLayout>
</ScrollView>
