<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="14dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/widget_photo"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_car_placeholder"
        android:contentDescription="@string/car_photo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/widget_car_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#e8e8ec"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Loading…" />

        <TextView
            android:id="@+id/widget_odometer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#ff6b1a"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingTop="2dp"
            android:text="" />

        <TextView
            android:id="@+id/widget_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#8b95a5"
            android:textSize="11sp"
            android:paddingTop="4dp"
            android:text="" />

        <TextView
            android:id="@+id/widget_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#cc5500"
            android:textSize="10sp"
            android:paddingTop="3dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="" />

    </LinearLayout>
</LinearLayout>
